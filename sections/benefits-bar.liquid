{%- if section.settings.show_section and section.blocks.size > 0 -%}
  <div class="benefits-bar" data-section-id="{{ section.id }}" data-section-type="benefits-bar">
    <div class="container">
      <ul class="benefits-bar__list">
        {%- for block in section.blocks -%}
          <li class="benefits-bar__item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <span class="benefits-bar__icon">{%- render 'icon', icon: block.settings.icon -%}</span>
            {%- endif -%}

            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="benefits-bar__text">{{ block.settings.text | escape }}</a>
            {%- else -%}
              <span class="benefits-bar__text">{{ block.settings.text | escape }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Benefits bar",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon name",
          "info": "Nombre del icono (ej. cs-boutique, cs-shield-gem, cs-loupe)"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Benefit text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "category": "Text",
      "name": "Benefits bar",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
